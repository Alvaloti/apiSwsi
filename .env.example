MONGO_URI=mongodb://usuario:contrasena@host:27017/swsi?authSource=swsi
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
PORT=5001
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=contrasena_smtp
