# Administrador creado automáticamente cuando todavía no existe uno activo.
# Cambia la contraseña antes del primer arranque y no la publiques en Git.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin.sistema
BOOTSTRAP_ADMIN_NOMINA=1000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Cambiar*AntesDeUsar1
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=Sistema
BOOTSTRAP_ADMIN_AREA=Administración
